{
  "manifest_version": 3,
  "name": "Archicad License Logger",
  "version": "1.2.0",
  "description": "Logs CAST's floating Archicad license use from Graphisoft License Management to a Google Sheet.",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "background",
    "idle"
  ],
  "host_permissions": [
    "https://licensemanagement.graphisoft.com/*",
    "https://id.graphisoft.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Archicad License Logger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
